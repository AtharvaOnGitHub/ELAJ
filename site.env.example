# Site-specific settings for ELAJ. Copy to site.env (ignored by git) and edit.
# Every Slurm script sources site.env from the repo root before it runs.

# Storage root on the cluster. Holds data/ (raw/, processed/), envs/, models/,
# scratch/, figures/ and R_libs/.
export ELAJ_BASE=/path/to/your/project/storage

# Only for scripts run on your own machine that copy files to the cluster
# (data_collation/scripts/push_weights.sh): your login as user@host.
# export ELAJ_REMOTE=user@cluster.example.org

# The Slurm account is NOT set here: sbatch reads it at submission time, so put
#   export SBATCH_ACCOUNT=your-slurm-account
# in ~/.bashrc on the cluster instead.
